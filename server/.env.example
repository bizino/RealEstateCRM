# Copy to server/.env and adjust for your environment
PORT=5001
DB_URL=mongodb://127.0.0.1:27017
DB=Prolink
# Secret used to sign login tokens. Use a long random value in production,
# e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`.
# Changing it logs every user out once.
JWT_SECRET=
# First admin account, only used when the database has no admin yet
# (defaults to the demo account admin@gmail.com / admin123)
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Address of the web client, Stripe sends customers back to <CLIENT_URL>/payments
CLIENT_URL=
STRIPE_PRIVATE_KEY=
# Outgoing email
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
